{
  "name": "astra-desktop",
  "version": "1.0.0",
  "description": "Codeastra Desktop — AI privacy layer for every app on your device",
  "main": "src/main.js",
  "scripts": {
    "start":     "electron .",
    "build":     "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "dependencies": {
    "node-forge":     "^1.3.1",
    "electron-store": "^8.1.0",
    "node-fetch":     "^2.7.0"
  },
  "devDependencies": {
    "electron":         "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId":       "dev.codeastra.desktop",
    "productName": "Astra",
    "mac": {
      "category": "public.app-category.productivity",
      "icon":     "public/icon.icns",
      "target":   [{ "target": "dmg", "arch": ["arm64", "x64"] }]
    },
    "win": {
      "icon":   "public/icon.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "files": ["src/**/*", "public/**/*"]
  }
}
